# Database (Supabase)
DATABASE_URL=
DIRECT_URL=

# OpenRouter (LLM — primary provider read by src/lib/ai.ts)
OPENROUTER_API_KEY=

# Gemini (LLM fallback, used if OPENROUTER_API_KEY is unset)
GEMINI_API_KEY=

# Groq (LLM fallback, used if neither of the above is set)
GROQ_API_KEY=

# Resend (Email)
RESEND_API_KEY=

# Shared secret required in the x-webhook-secret header for POST /api/webhook
WEBHOOK_SECRET=

# Meta (WhatsApp) — currently unused since the FlowAI pivot; kept for a future re-integration
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# JWT
JWT_SECRET=

# Default organization for seed
DEFAULT_ORG_NAME=My Company
DEFAULT_ORG_SLUG=my-company
